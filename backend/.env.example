# Scrapo Backend Environment Variables
ENVIRONMENT=development
PROJECT_NAME="Scrapo API"
API_V1_PREFIX=/api/v1

# Database Configuration
# PostgreSQL production/staging example:
DATABASE_URL=postgresql://scrapo_user:scrapo_password@localhost:5432/scrapo_db
# SQLite local development fallback:
# DATABASE_URL=sqlite:///./scrapo.db

# JWT Security
JWT_SECRET=super_secret_production_key_change_me_in_real_deployment_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRY=60
REFRESH_TOKEN_EXPIRY=10080

# CORS Configuration (JSON array string or comma separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Active Yard Timezone
DEFAULT_TIMEZONE=Asia/Kolkata
